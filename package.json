{
  "name": "@prospeo/n8n-nodes-prospeo",
  "version": "1.0.0",
  "description": "n8n community node for Prospeo - Find people and company data and enrich them with verified emails and mobile numbers.",
  "license": "MIT",
  "homepage": "https://prospeo.io",
  "keywords": [
    "n8n-community-node-package",
    "prospeo",
    "n8n",
    "sales",
    "marketing",
    "crm",
    "leads",
    "data-enrichment",
    "company-data",
    "contact-data"
  ],
  "author": {
    "name": "Apoorva Pandey",
    "email": "apoorva@prospeo.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prospeo-v2/n8n-nodes-prospeo.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ProspeoApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Prospeo/Prospeo.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
